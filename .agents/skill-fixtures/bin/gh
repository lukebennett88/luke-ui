#!/usr/bin/env bash
# Local GitHub CLI stub for skill behaviour tests. Does not call the network.
# State directory: $SKILL_FIXTURE_STATE (default: <repo>/.agents/skill-fixtures/.state).
set -euo pipefail

root="${SKILL_FIXTURE_ROOT:-}"
if [[ -z "$root" ]]; then
	here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
	root="$here"
fi
state="${SKILL_FIXTURE_STATE:-$root/.state}"
seed="$root/seed"
log="$state/writes.log"
mkdir -p "$state/issues" "$state/prs"

log_write() {
	printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}

die() {
	printf 'gh-stub: %s\n' "$*" >&2
	exit 1
}

ensure_seeded() {
	if [[ ! -d "$state/issues" ]] || [[ -z "$(ls -A "$state/issues" 2>/dev/null || true)" ]]; then
		if [[ -d "$seed/issues" ]]; then
			cp -R "$seed/issues/." "$state/issues/"
		fi
	fi
	if [[ ! -d "$state/prs" ]] || [[ -z "$(ls -A "$state/prs" 2>/dev/null || true)" ]]; then
		if [[ -d "$seed/prs" ]]; then
			cp -R "$seed/prs/." "$state/prs/"
		fi
	fi
}

next_id() {
	local kind="$1"
	local max=9000
	local f n
	for f in "$state/$kind"/*.json; do
		[[ -e "$f" ]] || continue
		n="$(basename "$f" .json)"
		if [[ "$n" =~ ^[0-9]+$ ]] && ((n > max)); then
			max=$n
		fi
	done
	echo $((max + 1))
}

cmd="${1:-}"
shift || true

case "$cmd" in
'' | -h | --help | help)
	cat <<'EOF'
gh-stub: local stand-in for `gh` used by .agents/skill-discovery.md.

Supported:
  gh issue create --title TITLE --body-file FILE|--body BODY
  gh issue view N [--json ...]
  gh issue list
  gh pr create --title TITLE --body-file FILE|--body BODY [--base BASE]
  gh pr view [N] [--json ...]
  gh pr edit N --title TITLE --body-file FILE|--body BODY
  gh api <path>   (limited read-backs for issues and pull requests)

Writes are recorded in $SKILL_FIXTURE_STATE/writes.log and can be read back.
EOF
	;;
issue)
	ensure_seeded
	sub="${1:-}"
	shift || true
	case "$sub" in
	create)
		title=""
		body=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--title)
				title="${2:-}"
				shift 2
				;;
			--body)
				body="${2:-}"
				shift 2
				;;
			--body-file)
				body="$(cat "${2:-}")"
				shift 2
				;;
			*)
				shift
				;;
			esac
		done
		[[ -n "$title" ]] || die 'issue create requires --title'
		id="$(next_id issues)"
		url="https://example.invalid/issues/$id"
		python3 - "$state/issues/$id.json" "$id" "$title" "$body" "$url" <<'PY'
import json, sys
path, id_, title, body, url = sys.argv[1:6]
json.dump({"number": int(id_), "title": title, "body": body, "url": url, "state": "OPEN"}, open(path, "w"), indent=2)
print(url)
PY
		log_write "issue create #$id title=$(printf '%s' "$title" | tr '\n' ' ')"
		;;
	view)
		num="${1:-}"
		[[ -n "$num" ]] || die 'issue view requires a number'
		num="${num#\#}"
		file="$state/issues/$num.json"
		[[ -f "$file" ]] || die "issue #$num not found"
		shift || true
		if [[ "${1:-}" == --json ]]; then
			cat "$file"
		else
			python3 - "$file" <<'PY'
import json, sys
issue = json.load(open(sys.argv[1]))
print(f"title:\t{issue['title']}")
print(f"state:\t{issue['state']}")
print(f"url:\t{issue['url']}")
print("---")
print(issue.get("body", ""))
PY
		fi
		;;
	list)
		python3 - "$state/issues" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
for path in sorted(root.glob("*.json"), key=lambda p: int(p.stem)):
    issue = json.loads(path.read_text())
    print(f"{issue['number']}\t{issue['state']}\t{issue['title']}")
PY
		;;
	*)
		die "unsupported issue subcommand: $sub"
		;;
	esac
	;;
pr)
	ensure_seeded
	sub="${1:-}"
	shift || true
	case "$sub" in
	create)
		title=""
		body=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--title)
				title="${2:-}"
				shift 2
				;;
			--body)
				body="${2:-}"
				shift 2
				;;
			--body-file)
				body="$(cat "${2:-}")"
				shift 2
				;;
			*)
				shift
				;;
			esac
		done
		[[ -n "$title" ]] || die 'pr create requires --title'
		id="$(next_id prs)"
		url="https://example.invalid/pull/$id"
		python3 - "$state/prs/$id.json" "$id" "$title" "$body" "$url" <<'PY'
import json, sys
path, id_, title, body, url = sys.argv[1:6]
json.dump({"number": int(id_), "title": title, "body": body, "url": url, "state": "OPEN"}, open(path, "w"), indent=2)
print(url)
PY
		log_write "pr create #$id title=$(printf '%s' "$title" | tr '\n' ' ')"
		;;
	view)
		num="${1:-}"
		if [[ -z "$num" || "$num" == --json ]]; then
			# latest
			num="$(ls "$state/prs"/*.json 2>/dev/null | sed 's/.*\///;s/\.json$//' | sort -n | tail -1 || true)"
			[[ -n "$num" ]] || die 'no pull requests in fixture state'
			[[ "${1:-}" == --json ]] || true
		else
			num="${num#\#}"
			shift || true
		fi
		file="$state/prs/$num.json"
		[[ -f "$file" ]] || die "pull request #$num not found"
		if [[ "${1:-}" == --json ]]; then
			cat "$file"
		else
			python3 - "$file" <<'PY'
import json, sys
pr = json.load(open(sys.argv[1]))
print(f"title:\t{pr['title']}")
print(f"state:\t{pr['state']}")
print(f"url:\t{pr['url']}")
print("---")
print(pr.get("body", ""))
PY
		fi
		;;
	edit)
		num="${1:-}"
		[[ -n "$num" ]] || die 'pr edit requires a number'
		num="${num#\#}"
		shift || true
		file="$state/prs/$num.json"
		[[ -f "$file" ]] || die "pull request #$num not found"
		title=""
		body=""
		while [[ $# -gt 0 ]]; do
			case "$1" in
			--title)
				title="${2:-}"
				shift 2
				;;
			--body)
				body="${2:-}"
				shift 2
				;;
			--body-file)
				body="$(cat "${2:-}")"
				shift 2
				;;
			*)
				shift
				;;
			esac
		done
		python3 - "$file" "$title" "$body" <<'PY'
import json, sys
path, title, body = sys.argv[1:4]
pr = json.load(open(path))
if title:
    pr["title"] = title
if body:
    pr["body"] = body
json.dump(pr, open(path, "w"), indent=2)
print(pr["url"])
PY
		log_write "pr edit #$num"
		;;
	*)
		die "unsupported pr subcommand: $sub"
		;;
	esac
	;;
api)
	ensure_seeded
	path="${1:-}"
	case "$path" in
	repos/*/issues/*)
		num="${path##*/}"
		file="$state/issues/$num.json"
		[[ -f "$file" ]] || die "issue #$num not found"
		cat "$file"
		;;
	repos/*/pulls/*)
		num="${path##*/}"
		file="$state/prs/$num.json"
		[[ -f "$file" ]] || die "pull request #$num not found"
		cat "$file"
		;;
	*)
		die "unsupported api path: $path"
		;;
	esac
	;;
*)
	die "unsupported command: $cmd (this is the skill-fixture stub, not real gh)"
	;;
esac
