#!/usr/bin/env bash
# Prepare a disposable checkout for skill behaviour scenarios.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$root/../.." && pwd)"
state="$root/.state"

log() {
	printf '%s\n' "$*" >&2
}

usage() {
	cat <<'EOF'
Usage: .agents/skill-fixtures/setup <command>

Commands:
  reset                 Clear fixture state and restore seeded issues/PRs.
  path-gh               Print PATH prefix that puts the gh stub first.
  parent-scope          Seed parent #9001 with ready #9002 and blocked #9003/#9004.
  dirty-task            Dirty the tree with files that belong to #9002.
  dirty-unrelated       Dirty the tree with files that belong to another task.
  docs-pr-diff          Stage a docs-only synthetic diff for review/PR metadata cases.
  tests-pr-diff         Stage a tests-only synthetic diff for review/specialist cases.
  publication-env       Print shell exports for the gh stub (stdout is eval-safe).

Run from a disposable copy of the repository. Do not point these commands at a shared checkout
you care about keeping clean.
EOF
}

require_disposable() {
	if [[ "${SKILL_FIXTURE_ALLOW_PRIMARY:-}" == "1" ]]; then
		return 0
	fi
	# Linked git worktrees use a `.git` file, not a directory.
	if [[ -f "$PWD/.git" ]]; then
		return 0
	fi
	# Plain copies opt in with a marker so the primary checkout stays protected.
	if [[ -f "$PWD/.agents/skill-fixtures/.disposable" ]]; then
		return 0
	fi
	log "setup: refusing to dirty this checkout. Use a linked worktree, run touch .agents/skill-fixtures/.disposable in a copy, or set SKILL_FIXTURE_ALLOW_PRIMARY=1."
	exit 1
}

sync_state_into_checkout() {
	local checkout_state="$PWD/.agents/skill-fixtures/.state"
	mkdir -p "$checkout_state/issues" "$checkout_state/prs"
	if [[ "$(cd "$state" && pwd)" != "$(cd "$checkout_state" && pwd)" ]]; then
		rm -rf "$checkout_state"
		mkdir -p "$checkout_state"
		cp -R "$state/." "$checkout_state/"
	fi
}

cmd_reset() {
	rm -rf "$state"
	mkdir -p "$state/issues" "$state/prs"
	cp -R "$root/seed/issues/." "$state/issues/"
	cp -R "$root/seed/prs/." "$state/prs/"
	: >"$state/writes.log"
	log "reset: seeded issues 9001-9004 and PR 9101 in $state"
}

cmd_path_gh() {
	printf '%s\n' "$root/bin"
}

cmd_parent_scope() {
	cmd_reset
	sync_state_into_checkout
	cat >"$PWD/.agents/skill-fixtures/CONTEXT.md" <<'EOF'
# Scenario context: parent scope

Work against the seeded issues served by the local `gh` stub:

- #9001 parent (OPEN), incomplete
- #9002 ready incomplete unit (OPEN)
- #9003 docs unit blocked on #9002
- #9004 tests unit blocked on #9002

Use `gh issue view <n>` (stub) for bodies. Do not restructure the issue graph.
EOF
	log "parent-scope: CONTEXT.md written; use PATH from setup path-gh or publication-env"
}

cmd_dirty_task() {
	require_disposable
	cmd_parent_scope
	mkdir -p "$PWD/packages/@luke-ui/react/src/core/form"
	cat >"$PWD/packages/@luke-ui/react/src/core/form/necessity-wip.ts" <<'EOF'
// WIP for #9002: Field necessity inheritance from Form.
export const necessityWip = 'task-owned unfinished work';
EOF
	cat >"$PWD/.agents/skill-fixtures/OWNERSHIP.md" <<'EOF'
# Ownership

`packages/@luke-ui/react/src/core/form/necessity-wip.ts` belongs to issue #9002 in this checkout.
Continue that work. Do not discard, reset, clean, or stash it.
EOF
	log "dirty-task: task-owned uncommitted file present"
}

cmd_dirty_unrelated() {
	require_disposable
	cmd_reset
	sync_state_into_checkout
	mkdir -p "$PWD/apps/docs/content/docs"
	cat >"$PWD/apps/docs/content/docs/unrelated-wip.mdx" <<'EOF'
# Unrelated WIP

This draft belongs to another task, not #9002 or #9001.
EOF
	cat >"$PWD/.agents/skill-fixtures/OWNERSHIP.md" <<'EOF'
# Ownership

`apps/docs/content/docs/unrelated-wip.mdx` is unrelated to #9002. It must remain in the working
tree. A new branch in this dirty checkout is not isolation.
EOF
	log "dirty-unrelated: unrelated uncommitted file present"
}

cmd_docs_pr_diff() {
	require_disposable
	cmd_reset
	sync_state_into_checkout
	mkdir -p "$PWD/apps/docs/content/docs/components/forms"
	cat >"$PWD/apps/docs/content/docs/components/forms/necessity-note.mdx" <<'EOF'
# Necessity note

Document that Field can inherit necessity from Form.
EOF
	cat >"$PWD/.agents/skill-fixtures/CONTEXT.md" <<'EOF'
# Scenario context: docs-only PR

Synthetic docs-only change for review and PR metadata cases. Seeded PR #9101 still claims
`Closes #9001` even though this diff does not satisfy the parent.
EOF
	log "docs-pr-diff: docs-only uncommitted file present"
}

cmd_tests_pr_diff() {
	require_disposable
	cmd_reset
	sync_state_into_checkout
	mkdir -p "$PWD/packages/@luke-ui/react/src/core/form"
	cat >"$PWD/packages/@luke-ui/react/src/core/form/necessity.browser.test.tsx" <<'EOF'
import { describe, expect, test } from 'vitest';

describe('necessity inheritance', () => {
	test('placeholder for review-pr + write-tests delegation', () => {
		expect(true).toBe(true);
	});
});
EOF
	cat >"$PWD/.agents/skill-fixtures/CONTEXT.md" <<'EOF'
# Scenario context: tests-only PR

Synthetic tests-only change for review specialist delegation. Review must stay read-only and
consult write-tests.
EOF
	log "tests-pr-diff: tests-only uncommitted file present"
}

cmd_publication_env() {
	cmd_reset
	local checkout_state="$PWD/.agents/skill-fixtures/.state"
	mkdir -p "$checkout_state"
	if [[ "$(cd "$state" && pwd)" != "$(cd "$checkout_state" && pwd)" ]]; then
		rm -rf "$checkout_state"
		mkdir -p "$checkout_state"
		cp -R "$state/." "$checkout_state/"
	fi
	# stdout only: safe for eval
	cat <<EOF
export SKILL_FIXTURE_ROOT="$PWD/.agents/skill-fixtures"
export SKILL_FIXTURE_STATE="$checkout_state"
export PATH="$root/bin:\$PATH"
EOF
	log "publication-env: exports printed on stdout; confirm with: command -v gh && gh issue view 9001"
}

main() {
	local cmd="${1:-}"
	shift || true
	case "$cmd" in
	'' | -h | --help | help) usage ;;
	reset) cmd_reset ;;
	path-gh) cmd_path_gh ;;
	parent-scope) cmd_parent_scope ;;
	dirty-task) cmd_dirty_task ;;
	dirty-unrelated) cmd_dirty_unrelated ;;
	docs-pr-diff) cmd_docs_pr_diff ;;
	tests-pr-diff) cmd_tests_pr_diff ;;
	publication-env) cmd_publication_env ;;
	*)
		log "unknown command: $cmd"
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
