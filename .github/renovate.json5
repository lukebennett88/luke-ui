{
	$schema: 'https://docs.renovatebot.com/renovate-schema.json',
	extends: [
		'config:recommended',
		// Commit subjects in this repo are plain imperative, so keep Renovate off conventional prefixes.
		':semanticCommitsDisabled',
	],
	labels: ['dependencies'],

	// Renovate has no manager for `devEngines.runtime`, the root `package.json` field that pins the
	// Node runtime. This regex finds the `runtime` object whose `name` is `node` and captures only the
	// major before `.x`, so an update rewrites the digits and keeps the `<major>.x` form.
	customManagers: [
		{
			customType: 'regex',
			managerFilePatterns: ['/^package\\.json$/'],
			matchStrings: [
				'"runtime"\\s*:\\s*\\{[^}]*?"name"\\s*:\\s*"node"[^}]*?"version"\\s*:\\s*"(?<currentValue>\\d+)\\.x"',
			],
			depNameTemplate: 'node',
			datasourceTemplate: 'node-version',
			versioningTemplate: 'node',
		},
	],

	// pnpm refuses to resolve any release younger than `minimumReleaseAge: 4320` (3 days) in
	// pnpm-workspace.yaml, so a PR raised for a fresher release cannot generate a lockfile.
	minimumReleaseAge: '3 days',
	// Hold the branch back until the release is old enough instead of opening a PR that cannot install.
	internalChecksFilter: 'strict',

	// One batch a week keeps the PR count down and resolves each new version once.
	schedule: ['before 6am on monday'],
	prConcurrentLimit: 8,
	prHourlyLimit: 0,

	// Catalog entries carry caret ranges, and `replace` would leave them untouched for every in-range
	// release. `bump` moves the declared range so pnpm-workspace.yaml stays the record of what is used.
	rangeStrategy: 'bump',

	// Transitive versions only move when the lockfile is regenerated, so refresh it on a slow cycle.
	lockFileMaintenance: {
		enabled: true,
		schedule: ['before 6am on the first day of the month'],
		automerge: false,
	},

	// Security fixes skip the quarantine. pnpm does not: a fix younger than 3 days still needs a
	// `minimumReleaseAgeExclude` entry added by hand before the lockfile will resolve.
	vulnerabilityAlerts: {
		minimumReleaseAge: null,
		addLabels: ['security'],
		automerge: false,
	},

	packageRules: [
		// Broad rule first. Later rules win, so the family groups below pull their members back out.
		{
			matchUpdateTypes: ['minor', 'patch'],
			groupName: 'non-major dependencies',
		},
		{
			// The catalog aliases `vite` to @voidzero-dev/vite-plus-core, pins it beside `vite-plus` and
			// `vitest` at exact versions, and `overrides` forces one copy workspace-wide. They only
			// resolve if they move in the same commit.
			matchPackageNames: [
				'@voidzero-dev/vite-plus-core',
				'@vitest/**',
				'vite',
				'vite-plus',
				'vitest',
			],
			groupName: 'vite-plus toolchain',
		},
		{
			// @types/react has to land with the react major it describes, so it stays out of the
			// automerged type-definitions group below.
			matchPackageNames: ['@types/react', '@types/react-dom', 'react', 'react-dom'],
			groupName: 'react',
		},
		{
			// react and react-dom are peerDependencies of the published package, and the catalog range is
			// what gets published. Widening it on every minor would narrow the range consumers can satisfy.
			matchDepTypes: ['pnpm.catalog.default'],
			matchPackageNames: ['react', 'react-dom'],
			rangeStrategy: 'replace',
		},
		{
			matchPackageNames: ['@react-aria/**', 'react-aria', 'react-aria-components'],
			groupName: 'react-aria',
		},
		{
			matchPackageNames: ['@vanilla-extract/**'],
			groupName: 'vanilla-extract',
		},
		{
			matchPackageNames: ['@capsizecss/**'],
			groupName: 'capsize',
		},
		{
			matchPackageNames: ['@tanstack/**'],
			groupName: 'tanstack',
		},
		{
			matchPackageNames: ['fumadocs-**'],
			groupName: 'fumadocs',
		},
		{
			matchPackageNames: ['@tailwindcss/**', 'tailwindcss'],
			groupName: 'tailwindcss',
		},
		{
			matchPackageNames: ['@turbo/**', 'turbo'],
			groupName: 'turbo',
		},
		{
			// Workflows pin actions at the major tag, so the only update Renovate can offer is a major tag
			// move. Read the changelog before merging one.
			matchManagers: ['github-actions'],
			groupName: 'github actions',
			automerge: false,
		},
		{
			// The `devEngines.runtime` Node major from the regex manager above. `replace` swaps the major,
			// where the top-level `bump` would rewrite it to an exact version. Renovate follows Node's
			// release schedule and only proposes stable LTS lines.
			matchManagers: ['custom.regex'],
			matchDepNames: ['node'],
			groupName: 'node',
			rangeStrategy: 'replace',
			automerge: false,
		},
		{
			// Keep `@types/node` on the Node major in root `devEngines.runtime` (`24.x`). Raise this bound
			// and the catalog entry when that major moves.
			matchPackageNames: ['@types/node'],
			allowedVersions: '<25',
		},
		{
			// pnpm is declared only in the root `packageManager` field. Keep it with the regenerated
			// lockfile in one PR.
			matchManagers: ['npm'],
			matchDepTypes: ['packageManager'],
			matchDepNames: ['pnpm'],
			groupName: 'pnpm',
			rangeStrategy: 'replace',
			automerge: false,
		},
		{
			// Type-only packages ship nothing to consumers and a bad bump fails `check:types`, so CI is a
			// sufficient reviewer. This is the only automerge in the config.
			matchPackageNames: ['@types/**', '!@types/react', '!@types/react-dom'],
			matchUpdateTypes: ['minor', 'patch'],
			groupName: 'type definitions',
			automerge: true,
		},
		{
			// Runtime, peer, and bundled dependencies of unpublished @luke-ui/react. The label is advance
			// notice until 1.0.0, when a bump here needs a changeset. Keep in step with `dependencies`,
			// `peerDependencies`, and `inlinedDependencies` in packages/@luke-ui/react/package.json.
			matchPackageNames: [
				'@capsizecss/core',
				'@react-aria/utils',
				'@vanilla-extract/dynamic',
				'@vanilla-extract/recipes',
				'csstype',
				'react',
				'react-aria',
				'react-aria-components',
				'react-dom',
				'spin-doctor',
			],
			addLabels: ['needs-changeset'],
			automerge: false,
		},
	],
}
