{
	"name": "@luke-ui/workflow-scripts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json --fix",
		"fix:lint:types:unsafe": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"test": "vp test run",
		"visual-ci": "tsx visual-ci.ts",
		"visual-local": "tsx visual-local.ts"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
