{
	"name": "@luke-ui/workflow-scripts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check:captures": "tsx check-visual-captures.ts",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint . --type-aware",
		"check:types": "tsc --noEmit -p tsconfig.json",
