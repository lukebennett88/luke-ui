{
	"name": "@spike/stylex-ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		"./precompiled/*.css": "./dist/precompiled/*.css",
		"./precompiled/*": "./dist/precompiled/*.js",
		"./precompiled-split/*.css": "./dist/precompiled-split/*.css",
		"./precompiled-split/*": "./dist/precompiled-split/*.js",
		"./source/*.css": "./dist/source/*.css",
		"./source/*": "./dist/source/*.js"
	},
	"scripts": {
		"build": "node scripts/generate-tokens.mjs && node scripts/build.mjs",
		"check:types": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@stylexjs/stylex": "0.19.1"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@babel/preset-react": "^7.27.0",
		"@babel/preset-typescript": "^7.27.0",
		"@stylexjs/babel-plugin": "0.19.1",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"react": "19.3.1",
		"react-aria-components": "1.22.1",
		"react-dom": "19.3.1",
		"typescript": "^5.9.0"
	},
	"peerDependencies": {
		"react": "^19",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19"
	}
}
