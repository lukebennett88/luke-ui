{
	"name": "design-system",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:docs": "turbo run build --filter=docs",
		"build:packages": "turbo run build --filter=./packages/**",
		"build:reference-app": "turbo run build --filter=reference-app",
		"changeset": "changeset",
		"check": "vp check && turbo run check:barrels check:docs check:llms check:types check:lint:types //#check:cycles:run //#check:unused:run",
		"check:cycles": "turbo run //#check:cycles:run",
		"check:cycles:run": "knip --cycles",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "turbo run check:lint:types",
		"check:types": "turbo run check:types",
		"check:unused": "turbo run //#check:unused:run",
		"check:unused:run": "knip",
		"clean": "node .github/scripts/clean.ts",
		"clean:build": "node .github/scripts/clean.ts --build",
		"clean:unsafe": "git clean -i -dX",
		"dev:docs": "turbo run dev --filter=docs --concurrency=16",
		"dev:reference-app": "turbo run dev --filter=reference-app",
		"fix": "pnpm run fix:lint && turbo run fix:lint:types && pnpm run fix:format",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"fix:unsafe": "turbo run //#fix:unused:run && pnpm run fix:lint:unsafe && turbo run fix:lint:types:unsafe && pnpm run fix:format",
		"fix:unused": "turbo run //#fix:unused:run",
		"fix:unused:run": "knip --fix",
		"generate": "turbo run generate",
		"lint:changed": "vp staged --no-stash --diff=\"$(git merge-base origin/main HEAD)\"",
		"release": "turbo run build --filter=docs^... && changeset publish",
		"scaffold:component": "pnpm --filter=@luke-ui/scaffolding run scaffold:component",
		"scaffold:primitive": "pnpm --filter=@luke-ui/scaffolding run scaffold:primitive",
		"test": "pnpm run test:code && pnpm run test:visual",
		"test:browser": "turbo run test:browser:run --filter=@luke-ui/react",
		"test:code": "turbo run test test:consumer:run test:integration --concurrency=1",
		"test:consumer": "turbo run test:consumer:run --filter=@luke-ui/react",
		"test:docs": "turbo run test --filter=docs",
		"test:integration": "turbo run test:integration",
		"test:reference-app": "turbo run test --filter=reference-app",
		"test:unit": "turbo run test:unit --filter=@luke-ui/react",
		"test:visual": "pnpm --filter=@luke-ui/workflow-scripts run visual-local -- compare",
		"test:visual:capture": "pnpm --filter=@luke-ui/workflow-scripts run visual-local -- capture",
		"test:visual:host": "turbo run test:visual:run --filter=@luke-ui/react",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"eslint-plugin-react-hooks": "catalog:",
		"knip": "catalog:",
		"turbo": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.15.0"
}
