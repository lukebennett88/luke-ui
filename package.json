{
	"name": "design-system",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"build:docs": "turbo run build --filter=docs",
		"build:packages": "turbo run build --filter=./packages/**",
		"changeset": "changeset",
		"check": "turbo run check check:cycles check:unused",
		"check:cycles": "knip --cycles",
		"check:format": "turbo run check:format-root check:format",
		"check:format-root": "vp fmt . --check",
		"check:lint": "turbo run check:lint",
		"check:types": "turbo run check:types",
		"check:unused": "knip",
		"clean": "turbo run clean && rm -rf node_modules",
		"dev": "turbo run dev",
		"dev:docs": "turbo run dev --filter=docs",
		"dev:packages": "turbo run dev --filter=./packages/**",
		"fix": "turbo run fix:format-root fix fix:unused",
		"fix:format": "turbo run fix:format-root fix:format",
		"fix:format-root": "vp fmt . --write",
		"fix:lint": "turbo run fix:lint",
		"fix:unsafe": "turbo run fix:unsafe",
		"fix:unused": "knip --fix",
		"generate:component": "pnpm --filter=@luke-ui/turbo-generators run generate:component",
		"generate:primitive": "pnpm --filter=@luke-ui/turbo-generators run generate:primitive",
		"release": "turbo run build --filter=docs^... && changeset publish",
		"test": "turbo run test",
		"test:visual": "pnpm --filter=@luke-ui/react run test:visual",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@turbo/gen": "catalog:",
		"eslint-plugin-react-hooks": "catalog:",
		"knip": "catalog:",
		"turbo": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
