{
	"name": "@luke-ui/playground-core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./compiler": "./dist/compiler.js",
		"./format": "./dist/format.js",
		"./generate": "./dist/generate.js",
		"./hash": "./dist/hash.js",
		"./package.json": "./package.json",
		"./protocol": "./dist/protocol.js",
		"./specifiers": "./dist/specifiers.js"
	},
	"scripts": {
		"build": "vp pack",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint src --type-aware --tsconfig tsconfig.browser.json --config ../../../.oxlintrc.types.json",
		"check:lint:types:node": "vp lint src/node --type-aware --tsconfig tsconfig.node.json --config ../../../.oxlintrc.types.json",
		"check:types:browser": "tsc --noEmit -p tsconfig.browser.json",
		"check:types:node": "tsc --noEmit -p tsconfig.node.json",
		"clean:build": "rm -rf dist",
		"dev": "vp pack --watch --no-clean",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint src --type-aware --tsconfig tsconfig.browser.json --config ../../../.oxlintrc.types.json --fix && vp lint src/node --type-aware --tsconfig tsconfig.node.json --config ../../../.oxlintrc.types.json --fix",
		"fix:lint:types:unsafe": "vp lint src --type-aware --tsconfig tsconfig.browser.json --config ../../../.oxlintrc.types.json --fix --fix-suggestions --fix-dangerously && vp lint src/node --type-aware --tsconfig tsconfig.node.json --config ../../../.oxlintrc.types.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"test": "vp test run --config vitest.config.ts"
	},
	"dependencies": {
		"lz-string": "catalog:",
		"prettier": "catalog:",
		"sucrase": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	}
}
