{
	"name": "@luke-ui/playground-core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint . --type-aware",
