{
	"name": "@luke-ui/theme-tactile",
	"version": "0.0.0",
	"description": "Tactile, the default Luke UI theme: a teal accent, a neutral near-white light canvas, and a restrained dimensional material.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukebennett88/luke-ui.git",
		"directory": "packages/@luke-ui/theme-tactile"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": [
		"./dist/fonts.css",
		"./dist/stylesheet.css"
	],
	"exports": {
		".": "./dist/index.js",
		"./input": "./dist/input.js",
		"./stylesheet.css": "./dist/stylesheet.css",
		"./fonts.css": "./dist/fonts.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack && node scripts/build-stylesheet.js && publint",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint . --type-aware",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"clean": "rm -rf .turbo dist",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --type-aware --fix",
		"test": "vp test run"
	},
	"devDependencies": {
		"@capsizecss/unpack": "catalog:",
		"@fontsource-variable/inter": "catalog:",
		"@luke-ui/react": "workspace:*",
		"@types/node": "catalog:",
		"publint": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@luke-ui/react": "workspace:^"
	}
}
