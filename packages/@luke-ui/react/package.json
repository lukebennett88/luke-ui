{
	"name": "@luke-ui/react",
	"version": "0.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukebennett88/luke-ui.git",
		"directory": "packages/@luke-ui/react"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css.ts",
		"./dist/stylesheet.css",
		"./dist/themes/*/stylesheet.css"
	],
	"exports": {
		"./aspect-ratio": "./dist/aspect-ratio.js",
		"./blockquote": "./dist/blockquote.js",
		"./box": "./dist/box.js",
		"./button": "./dist/button.js",
		"./checkbox": "./dist/checkbox.js",
		"./cluster": "./dist/cluster.js",
		"./code": "./dist/code.js",
		"./combobox-field": "./dist/combobox-field.js",
		"./container": "./dist/container.js",
		"./em": "./dist/em.js",
		"./emoji": "./dist/emoji.js",
		"./heading": "./dist/heading.js",
		"./icon": "./dist/icon.js",
		"./icon-button": "./dist/icon-button.js",
		"./icon-link": "./dist/icon-link.js",
		"./kbd": "./dist/kbd.js",
		"./link": "./dist/link.js",
		"./loading-skeleton": "./dist/loading-skeleton.js",
		"./loading-spinner": "./dist/loading-spinner.js",
		"./numeral": "./dist/numeral.js",
		"./primitives/button": "./dist/primitives/button.js",
		"./primitives/checkbox": "./dist/primitives/checkbox.js",
		"./primitives/combobox": "./dist/primitives/combobox.js",
		"./primitives/field": "./dist/primitives/field.js",
		"./primitives/input-group": "./dist/primitives/input-group.js",
		"./prose": "./dist/prose.js",
		"./quote": "./dist/quote.js",
		"./stack": "./dist/stack.js",
		"./strong": "./dist/strong.js",
		"./styles": "./dist/styles.js",
		"./text": "./dist/text.js",
		"./text-field": "./dist/text-field.js",
		"./theme": "./dist/theme.js",
		"./themes/paper": "./dist/themes/paper.js",
		"./themes/tactile": "./dist/themes/tactile.js",
		"./track": "./dist/track.js",
		"./utils": "./dist/utils.js",
		"./visually-hidden": "./dist/visually-hidden.js",
		"./package.json": "./package.json",
		"./stylesheet.css": "./dist/stylesheet.css",
		"./spritesheet.svg": "./dist/spritesheet.svg",
		"./themes/tactile/stylesheet.css": "./dist/themes/tactile/stylesheet.css",
		"./themes/paper/stylesheet.css": "./dist/themes/paper/stylesheet.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm run build:tsdown",
		"build:tsdown": "vp pack",
		"check:barrels": "unbarrelify --check --skip 'src/exports/**/*.ts' --skip 'src/theme/index.ts' --skip 'src/theme/bundles/*/index.ts'",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint . --type-aware",
		"check:types": "pnpm run check:types:browser && pnpm run check:types:node",
		"check:types:browser": "tsc --noEmit -p tsconfig.json",
		"check:types:node": "tsc --noEmit -p scripts/tsconfig.json",
		"clean": "rm -rf .turbo .generated dist",
		"dev": "pnpm run dev:tsdown",
		"dev:tsdown": "vp pack --watch",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --type-aware --fix",
		"fix:unsafe": "vp lint . --type-aware --fix-dangerously",
		"generate": "pnpm run generate:assets",
		"generate:assets": "pnpm run generate:icons && pnpm run generate:themes",
		"generate:icons": "tsx scripts/build-icons.ts",
		"generate:themes": "tsx scripts/build-themes.ts",
		"test": "pnpm run test:ci",
		"test:browser": "turbo run test:browser:run",
		"test:browser:run": "vp test run --project=browser --tagsFilter='!visual'",
		"test:ci": "pnpm run generate && pnpm run build && pnpm run test:unit && pnpm run test:browser",
		"test:ui": "turbo run test:ui:run",
		"test:ui:run": "vp test --project=browser --ui",
		"test:unit": "vp test run --project=unit",
		"test:visual": "turbo run test:visual:run",
		"test:visual:capture": "turbo run test:visual:capture:run",
		"test:visual:capture:run": "vp test run --project=browser --tagsFilter='visual' --update",
		"test:visual:run": "tsx scripts/visual-regression.ts",
		"test:watch": "turbo run test:watch:run",
		"test:watch:run": "vp test --project=browser --tagsFilter='!visual'"
	},
	"dependencies": {
		"@capsizecss/metrics": "catalog:",
		"@capsizecss/vanilla-extract": "catalog:",
		"@luke-ui/rainbow-sprinkles": "workspace:*",
		"@react-aria/utils": "catalog:",
		"@vanilla-extract/css": "catalog:",
		"@vanilla-extract/dynamic": "catalog:",
		"@vanilla-extract/recipes": "catalog:",
		"csstype": "catalog:",
		"spin-doctor": "catalog:"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "catalog:",
		"@rolldown/pluginutils": "catalog:",
		"@types/node": "catalog:",
		"@types/pngjs": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/rollup-plugin": "catalog:",
		"@vanilla-extract/vite-plugin": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"@vitest/ui": "catalog:",
		"axe-core": "catalog:",
		"lightningcss": "catalog:",
		"node-html-parser": "catalog:",
		"oxc-transform-react": "catalog:",
		"pixelmatch": "catalog:",
		"playwright": "catalog:",
		"pngjs": "catalog:",
		"publint": "catalog:",
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unbarrelify": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:"
	}
}
