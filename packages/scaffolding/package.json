{
	"name": "@luke-ui/scaffolding",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json",
		"check:types": "tsc --noEmit -p tsconfig.json",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --fix",
		"fix:lint:types:unsafe": "vp lint . --type-aware --tsconfig tsconfig.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"scaffold:component": "tsx scripts/generate.ts component",
		"scaffold:primitive": "tsx scripts/generate.ts primitive",
		"test": "vp test run"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "catalog:",
		"oxc-parser": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"zod": "catalog:"
	}
}
