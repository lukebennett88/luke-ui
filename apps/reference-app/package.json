{
	"name": "reference-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vp build",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json",
		"check:types": "tsc --noEmit",
		"clean:build": "rm -rf dist",
		"dev": "vp dev",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --fix",
		"fix:lint:types:unsafe": "vp lint . --type-aware --tsconfig tsconfig.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"preview": "vp preview",
		"test": "vp test run --project=browser"
	},
	"dependencies": {
		"@capsizecss/metrics": "catalog:",
		"@luke-ui/react": "workspace:*",
		"@tanstack/react-query": "catalog:",
		"@vanilla-extract/css": "catalog:",
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/vite-plugin": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
