{
	"name": "reference-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run generate:theme && vp build",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint . --type-aware",
		"check:types": "tsc --noEmit",
		"clean": "rm -rf .turbo dist src/generated",
		"dev": "pnpm run generate:theme && vp dev",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --type-aware --fix",
		"generate:theme": "tsx scripts/generate-theme.ts",
		"preview": "vp preview",
		"test": "vp test run --project=browser"
	},
	"dependencies": {
		"@luke-ui/react": "workspace:*",
		"@vanilla-extract/css": "catalog:",
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:",
		"react-router": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/vite-plugin": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
