{
	"name": "docs",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukebennett88/luke-ui.git"
	},
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#docs": "./src/examples/docs.tsx"
	},
	"scripts": {
		"build": "vp build && node scripts/write-not-found-page.ts && tsx scripts/check-metadata-output.ts && tsx scripts/check-type-definition-links.ts",
		"check:docs": "tsx scripts/check-docs.ts",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json",
		"check:llms": "tsx scripts/check-llms-output.ts",
		"check:type-definition-links": "tsx scripts/check-type-definition-links.ts",
		"check:types": "tsc --noEmit",
		"clean:build": "rm -rf .source .tanstack .output dist src/routeTree.gen.ts",
		"clean:generated-props": "tsx scripts/clean-generated-props-pages.ts",
		"dev": "vp dev",
		"dev:components-index": "tsx watch --include \"content/docs/components\" scripts/generate-components-index.ts",
		"dev:playground:scope": "tsx watch --include \"../../packages/@luke-ui/react/package.json\" --include \"../../packages/@luke-ui/playground-core/dist/generate.js\" --include \"../../packages/@luke-ui/playground-core/dist/specifiers.js\" scripts/generate-playground-scope.ts",
		"dev:playground:types": "tsx watch --include \"src/examples/docs.tsx\" --include \"package.json\" --include \"../../packages/@luke-ui/react/dist\" --include \"../../packages/@luke-ui/react/package.json\" --include \"../../packages/@luke-ui/playground-core/dist/generate.js\" scripts/generate-playground-types.ts",
		"dev:scripts": "vp pack --watch",
		"dev:token-reference": "tsx watch --include \"../../packages/@luke-ui/react/src/theme\" --include \"../../packages/@luke-ui/react/src/shared\" scripts/generate-token-reference.ts",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --fix",
		"fix:lint:types:unsafe": "vp lint . --type-aware --tsconfig tsconfig.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"generate:components-index": "node scripts/generate-components-index.ts",
		"generate:mdx": "fumadocs-mdx",
		"generate:playground:scope": "node scripts/generate-playground-scope.ts",
		"generate:playground:types": "node scripts/generate-playground-types.ts",
		"generate:routes": "tsr generate",
		"generate:scripts": "vp pack",
		"generate:token-reference": "tsx scripts/generate-token-reference.ts",
		"preview": "vp preview",
		"start": "serve .output/public",
		"test": "vp test run --config vitest.config.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "catalog:",
		"@luke-ui/playground-core": "workspace:*",
		"@luke-ui/react": "workspace:*",
		"@luke-ui/theme-paper": "workspace:*",
		"@luke-ui/theme-tactile": "workspace:*",
		"@monaco-editor/react": "catalog:",
		"@react-aria/utils": "catalog:",
		"@shikijs/monaco": "catalog:",
		"@tanstack/react-form": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-start": "catalog:",
		"@tanstack/start-static-server-functions": "catalog:",
		"@vanilla-extract/css": "catalog:",
		"@vanilla-extract/dynamic": "catalog:",
		"@vanilla-extract/recipes": "catalog:",
		"fumadocs-core": "catalog:",
		"fumadocs-mdx": "catalog:",
		"fumadocs-typescript": "catalog:",
		"fumadocs-ui": "catalog:",
		"monaco-editor": "catalog:",
		"oxc-parser": "catalog:",
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-hook-form": "catalog:",
		"react-resizable-panels": "catalog:",
		"shiki": "catalog:",
		"spin-doctor": "catalog:",
		"vite": "catalog:",
		"zbsearch": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@capsizecss/metrics": "catalog:",
		"@tanstack/router-cli": "catalog:",
		"@types/mdx": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/vite-plugin": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "catalog:",
		"playwright": "catalog:",
		"schema-dts": "catalog:",
		"serve": "catalog:",
		"ts-morph": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unist-util-visit": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
