{
	"name": "docs",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lukebennett88/luke-ui.git"
	},
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#docs": "./src/examples/docs.tsx"
	},
	"scripts": {
		"build": "vp build && node scripts/write-not-found-page.ts && tsx scripts/check-metadata-output.ts && tsx scripts/check-type-definition-links.ts",
		"check:docs": "tsx scripts/check-docs.ts",
		"check:format": "vp fmt . --check",
		"check:lint": "vp lint .",
		"check:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json",
		"check:llms": "tsx scripts/check-llms-output.ts",
		"check:type-definition-links": "tsx scripts/check-type-definition-links.ts",
		"check:types": "tsc --noEmit",
		"clean:build": "rm -rf .source .tanstack .output dist src/routeTree.gen.ts",
		"clean:generated-props": "tsx scripts/clean-generated-props-pages.ts",
		"dev": "vp dev",
		"dev:components-index": "nodemon --watch content/docs --watch scripts/generate-components-index.ts --ext md,mdx,json,svg,ts --exec \"node --import tsx scripts/generate-components-index.ts\"",
		"dev:playground:scope": "nodemon --watch src/lib/docs-playground-specifiers.ts --watch ../../packages/@luke-ui/react/package.json --watch ../../packages/@luke-ui/playground-core/dist --watch scripts/generate-playground-scope.ts --ext ts,js,mjs,cjs,json,css,svg,map --exec \"node --import tsx scripts/generate-playground-scope.ts\"",
		"dev:playground:types": "nodemon --watch src/examples/docs.tsx --watch package.json --watch ../../packages/@luke-ui/react/dist --watch ../../packages/@luke-ui/react/package.json --watch ../../packages/@luke-ui/playground-core/dist --watch scripts/generate-playground-types.ts --ext ts,tsx,js,mjs,cjs,json,css,svg,map --exec \"node --import tsx scripts/generate-playground-types.ts\"",
		"dev:scripts": "vp pack --watch",
		"dev:token-reference": "nodemon --watch ../../packages/@luke-ui/react/src/theme --watch ../../packages/@luke-ui/react/src/shared --watch scripts/generate-token-reference.ts --ext ts,tsx --exec \"node --import tsx scripts/generate-token-reference.ts\"",
		"fix:format": "vp fmt . --write",
		"fix:lint": "vp lint . --fix",
		"fix:lint:types": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json --fix",
		"fix:lint:types:unsafe": "vp lint . --type-aware --tsconfig tsconfig.json --config ../../.oxlintrc.types.json --fix --fix-suggestions --fix-dangerously",
		"fix:lint:unsafe": "vp lint . --fix --fix-suggestions --fix-dangerously",
		"generate:components-index": "node scripts/generate-components-index.ts",
		"generate:mdx": "fumadocs-mdx",
		"generate:playground:scope": "node scripts/generate-playground-scope.ts",
		"generate:playground:types": "node scripts/generate-playground-types.ts",
		"generate:routes": "tsr generate",
		"generate:scripts": "vp pack",
		"generate:token-reference": "tsx scripts/generate-token-reference.ts",
		"preview": "vp preview",
		"start": "serve .output/public",
		"test": "vp test run --config vitest.config.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "catalog:",
		"@luke-ui/playground-core": "workspace:*",
		"@luke-ui/react": "workspace:*",
		"@luke-ui/theme-paper": "workspace:*",
		"@luke-ui/theme-tactile": "workspace:*",
		"@monaco-editor/react": "catalog:",
		"@react-aria/utils": "catalog:",
		"@shikijs/monaco": "catalog:",
		"@tanstack/react-form": "catalog:",
		"@tanstack/react-router": "catalog:",
		"@tanstack/react-start": "catalog:",
		"@tanstack/start-static-server-functions": "catalog:",
		"@vanilla-extract/css": "catalog:",
		"@vanilla-extract/dynamic": "catalog:",
		"@vanilla-extract/recipes": "catalog:",
		"fumadocs-core": "catalog:",
		"fumadocs-mdx": "catalog:",
		"fumadocs-typescript": "catalog:",
		"fumadocs-ui": "catalog:",
		"monaco-editor": "catalog:",
		"oxc-parser": "catalog:",
		"react": "catalog:",
		"react-aria-components": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-hook-form": "catalog:",
		"react-resizable-panels": "catalog:",
		"shiki": "catalog:",
		"spin-doctor": "catalog:",
		"vite": "catalog:",
		"zbsearch": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@capsizecss/metrics": "catalog:",
		"@tanstack/router-cli": "catalog:",
		"@types/mdx": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vanilla-extract/vite-plugin": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"axe-core": "catalog:",
		"nodemon": "catalog:",
		"playwright": "catalog:",
		"schema-dts": "catalog:",
		"serve": "catalog:",
		"ts-morph": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unist-util-visit": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	}
}
