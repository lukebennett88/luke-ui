{
	"$schema": "https://v2-8-10.turborepo.dev/schema.json",
	"tasks": {
		"@luke-ui/react#check:lint": {
			"dependsOn": ["build", "generate"]
		},
		"@luke-ui/react#check:types": {
			"dependsOn": ["build", "^build"]
		},
		"@luke-ui/react#fix:lint": {
			"dependsOn": ["build", "generate"]
		},
		"@luke-ui/react#test": {
			"dependsOn": ["build", "^build", "generate"],
			"outputs": []
		},
		"//#check:cycles": {
			"cache": true,
			"dependsOn": ["@luke-ui/react#generate", "docs#generate"]
		},
		"//#check:format-root": {
			"cache": true
		},
		"//#check:unused": {
			"cache": true,
			"dependsOn": ["@luke-ui/react#generate", "docs#generate"]
		},
		"//#fix:format-root": {
			"cache": false
		},
		"//#fix:unused": {
			"cache": false,
			"dependsOn": ["@luke-ui/react#generate", "docs#generate"]
		},
		"build": {
			"dependsOn": ["^build", "generate"],
			"env": ["DOCS_STATIC", "SITE_URL", "VITE_BASE_URL"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".output/**", ".source/**"]
		},
		"check": {
			"dependsOn": [
				"check:barrels",
				"check:docs",
				"check:format",
				"//#check:format-root",
				"check:lint",
				"check:llms",
				"check:types"
			]
		},
		"check:barrels": {
			"dependsOn": ["generate"]
		},
		"check:docs": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/docs/**",
				"$TURBO_ROOT$/packages/@luke-ui/react/package.json",
				"$TURBO_ROOT$/packages/@luke-ui/react/src/**/*.ts",
				"$TURBO_ROOT$/packages/@luke-ui/react/src/**/*.tsx"
			]
		},
		"check:format": {
			"dependsOn": ["generate"]
		},
		"check:lint": {
			"dependsOn": ["generate", "^build"]
		},
		"check:llms": {},
		"check:types": {
			"dependsOn": ["generate", "^build"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"dependsOn": ["generate", "^build"],
			"persistent": true
		},
		"docs#build": {
			"dependsOn": ["docs#generate", "^build"],
			"env": ["DOCS_STATIC", "SITE_URL", "VITE_BASE_URL"],
			"outputs": [".netlify/**", ".output/**", ".source/**", "dist/**"]
		},
		"docs#check:format": {
			"dependsOn": ["docs#generate"]
		},
		"docs#check:lint": {
			"dependsOn": ["docs#generate", "^build"]
		},
		"docs#check:llms": {
			"dependsOn": ["docs#build"]
		},
		"docs#check:ssr-nav": {
			"cache": false,
			"dependsOn": ["docs#build"]
		},
		"docs#check:types": {
			"dependsOn": ["docs#generate", "^build"]
		},
		"docs#clean:generated-props": {
			"cache": false
		},
		"docs#dev": {
			"cache": false,
			"dependsOn": ["docs#generate", "^build"],
			"persistent": true
		},
		"docs#generate": {
			"cache": true,
			"dependsOn": ["docs#clean:generated-props", "^build"],
			"outputs": ["src/routeTree.gen.ts", "src/generated/**"]
		},
		"fix": {
			"cache": false,
			"dependsOn": ["fix:format", "fix:lint"]
		},
		"fix:format": {
			"cache": false,
			"dependsOn": ["generate"]
		},
		"fix:lint": {
			"cache": false,
			"dependsOn": ["generate"]
		},
		"fix:unsafe": {
			"cache": false,
			"dependsOn": ["generate"]
		},
		"generate": {
			"dependsOn": ["^generate"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!dist/**",
				"!.generated/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"outputs": [".generated/**", "src/routeTree.gen.ts"]
		},
		"test": {
			"dependsOn": ["^build", "generate"],
			"outputs": []
		},
		"test:browser:run": {
			"cache": false,
			"dependsOn": ["build"],
			"outputs": []
		},
		"test:ui:run": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true,
			"with": ["dev"]
		},
		"test:visual:capture:run": {
			"cache": false,
			"dependsOn": ["build"],
			"outputs": [],
			"passThroughEnv": ["VISUAL_CAPTURE_DIR"]
		},
		"test:visual:run": {
			"cache": false,
			"dependsOn": ["build"],
			"outputs": [],
			"passThroughEnv": ["VISUAL_BASELINE_DIR", "VISUAL_CAPTURE_DIR"]
		},
		"test:watch:run": {
			"cache": false,
			"dependsOn": ["build"],
			"persistent": true,
			"with": ["dev"]
		}
	}
}
